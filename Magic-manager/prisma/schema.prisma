// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Modèles pour l'authentification NextAuth.js
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("user") // user, moderator, admin
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  decks         Deck[]
  collections   Collection[]
  collectionCards CollectionCard[]
  comments      Comment[]
  likes         Like[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Modèles pour l'application Magic: The Gathering
model Deck {
  id          String   @id @default(cuid())
  name        String
  description String?
  format      String   // standard, commander, modern, etc.
  isPublic    Boolean  @default(false)
  likesCount  Int      @default(0)
  viewsCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  cards       DeckCard[]
  comments    Comment[]
  likes       Like[]
  
  @@index([userId])
  @@index([format])
}

model DeckCard {
  id       String @id @default(cuid())
  quantity Int    @default(1)
  isCommander Boolean @default(false)
  isCompanion Boolean @default(false)
  
  deckId   String
  deck     Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)
  
  cardId   String
  card     Card   @relation(fields: [cardId], references: [scryfallId], onDelete: Cascade)
  
  @@unique([deckId, cardId])
}

model Collection {
  id          String   @id @default(cuid())
  name        String
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

model CollectionCard {
  id        String @id @default(cuid())
  quantity  Int    @default(1)
  condition String @default("near_mint") // mint, near_mint, lightly_played, etc.
  isFoil    Boolean @default(false)
  language  String @default("en") // en, fr
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  cardId    String
  card      Card     @relation(fields: [cardId], references: [scryfallId], onDelete: Cascade)
  
  @@unique([userId, cardId, isFoil, language])
  @@index([userId])
}

model Card {
  id              String   @id @default(cuid())
  scryfallId      String   @unique // ID de l'API Scryfall
  name            String
  nameFr          String?
  manaCost        String?
  cmc             Float?
  typeLine        String
  oracleText      String?
  power           String?
  toughness       String?
  colors          String?  // JSON array
  colorIdentity   String?  // JSON array
  rarity          String
  set             String
  setName         String
  collectorNumber String
  imageUrl        String?
  prices          String?  // JSON object
  legalities      String?  // JSON object
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  deckCards       DeckCard[]
  collectionCards CollectionCard[]
  
  @@index([name])
  @@index([set])
  @@index([rarity])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  deckId    String
  deck      Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  
  @@index([deckId])
}

model Like {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  deckId    String
  deck      Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  
  @@unique([userId, deckId])
}
